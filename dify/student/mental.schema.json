{
  "additionalProperties": false,
  "properties": {
    "emotion_tag": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Emotion Tag",
      "type": "string"
    },
    "emotion_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Emotion Score"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "trigger_reason": {
      "default": "",
      "maxLength": 2000,
      "title": "Trigger Reason",
      "type": "string"
    }
  },
  "required": [
    "emotion_tag",
    "emotion_score",
    "risk_level"
  ],
  "title": "MentalAssessment",
  "type": "object"
}
