{
  "$defs": {
    "MentalAssessment": {
      "additionalProperties": false,
      "properties": {
        "emotion_tag": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Emotion Tag",
          "type": "string"
        },
        "emotion_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Emotion Score"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "trigger_reason": {
          "default": "",
          "maxLength": 2000,
          "title": "Trigger Reason",
          "type": "string"
        }
      },
      "required": [
        "emotion_tag",
        "emotion_score",
        "risk_level"
      ],
      "title": "MentalAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "intent": {
      "enum": [
        "leave",
        "mental",
        "feedback",
        "academic",
        "progress",
        "life",
        "upgrade"
      ],
      "title": "Intent",
      "type": "string"
    },
    "answer": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "mental": {
      "$ref": "#/$defs/MentalAssessment"
    },
    "action": {
      "default": "none",
      "enum": [
        "none",
        "leave.submit",
        "ticket.submit",
        "reminder.set",
        "academic.query",
        "progress.query",
        "leave.query",
        "ticket.query",
        "reminders.query",
        "notifications.query"
      ],
      "title": "Action",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    }
  },
  "required": [
    "intent",
    "answer",
    "mental"
  ],
  "title": "ChatDecision",
  "type": "object"
}
