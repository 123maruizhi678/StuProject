# 项目配置模板：依据 app/config.py 当前已实现字段整理。
# 程序自动读取本文件中的公共默认值；同名系统环境变量优先。
# 真实账号、密码、签名密钥和应用Key只通过启动环境变量注入，不写入本文件。
# 项目不再依赖或保存 .env；本文件可以公开提交，不得填入真实凭据。

# ===== 1. MySQL：将实际连接信息注入同名环境变量 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=education_agent
DB_ECHO=false
# 注入环境变量时保留密码原始字符；不要把真实密码填到本模板。
# 本模板不创建数据库或数据表；认证成功后再运行只读结构预检。

# ===== 2. 统一登录：必须单独生成随机签名密钥 =====
# AUTH_SECRET_KEY 与 STUDENT_ACTION_SECRET 分别通过环境变量注入不同的随机值，至少32字节。
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=120

# ===== 3. Dify 公共连接与唯一学生应用 =====
# API 基址包含 /v1，末尾不要填写 /workflows/run。
DIFY_API_BASE=http://127.0.0.1/v1
DIFY_API_TIMEOUT_SECONDS=60
# 通过环境变量注入已发布的“学生统一 Workflow”应用 API Key；不是模型供应商 Key。
STUDENT_DIFY_KEY=
# 仅签发学生会话和办理确认凭证，不替代公共登录 JWT。
STUDENT_ACTION_SECRET=
STUDENT_ACTION_TTL_SECONDS=300
STUDENT_TOKEN_ISSUER=stuproject
STUDENT_ANALYSIS_VERSION=student-assistant-v1

# ===== 4. 本地固定查询、知识与课程 =====
# 默认 local：读本地固定查询，不需要额外部署学生 NL2SQL 智能体。
STUDENT_QUERY_BACKEND=local
STUDENT_KNOWLEDGE_FILE=dify/student/knowledge.json
STUDENT_COURSES_FILE=scripts/student/student_courses.json
# 真实课程及本人选课关系由维护人员配置，格式参照 scripts/student/student_courses.example.json。
# 文件不存在时课程接口返回依赖未就绪，不会从成绩或招生项目猜测课程。

# ===== 5. 站内通知与负责人接管 =====
STUDENT_NOTIFICATION_MAX_ATTEMPTS=5
STUDENT_NOTIFICATION_LEASE_SECONDS=60
# 请假额外分派授权：JSON对象，“员工内部ID”对应“允许接管的部门内部ID列表”。
# 有效主管的本部门权限由后端另行校验；以下默认不额外授权。
STUDENT_LEAVE_ASSIGNMENT_SCOPES={}
# 心理分派需同时配置专属授权人员及其学生范围，不因主管或管理员身份自动授权。
STUDENT_WARNING_ASSIGNER_IDS=[]
STUDENT_WARNING_ASSIGNMENT_SCOPES={}

# ===== 6. 可选外部适配：当前本地流程无需开启 =====
# 数组/对象字段必须使用合法JSON；以下保持空值即不配置外部适配。
STUDENT_SYNC_ENABLED=false
STUDENT_SYNC_TOKEN=
STUDENT_SYNC_ALLOWED_SOURCES=[]
STUDENT_SYNC_ALLOWED_STUDENT_IDS=[]
STUDENT_SYNC_INTERVAL_SECONDS=300
STUDENT_EDUCATION_URL=
STUDENT_EDUCATION_TOKEN=
STUDENT_CRM_URL=
STUDENT_CRM_TOKEN=
# 仅在切换到已实现 student-v1 契约的 group 查询服务时填写。
STUDENT_NL2SQL_URL=
STUDENT_NL2SQL_TOKEN=
# 外部适配请求超时；Dify调用使用上方公共超时配置。
STUDENT_HTTP_TIMEOUT=30
# 当前通知任务只启用站内发布，不需要填写Webhook。
STUDENT_NOTIFICATION_URL=
STUDENT_NOTIFICATION_TOKEN=

# ===== 7. 公共日志 =====
LOG_LEVEL=INFO
# 留空时使用项目 app/logs 目录。
LOG_DIR=

# ===== 8. 其他模块的现有可选配置 =====
# 不启用对应模块时不注入；启用后通过相应环境变量提供真实配置。
REPORT_DIFY_API_BASE=
REPORT_DIFY_API_KEY=
REPORT_DIFY_OUTPUT_KEY=report_text
ENTERPRISE_SCORE_AUTHORITY=local
ENTERPRISE_STUDENT_MAINTAINER_IDS=[]
# 旧通用NL2SQL兼容配置，不作为学生统一应用Key。
DIFY_API_KEY=
DIFY_SQL_OUTPUT_KEY=sql
# 历史请假/成绩应用Key默认不配置；学生只部署一个统一Workflow。
STUDENT_DIFY_LEAVE_KEY=
STUDENT_DIFY_LEAVE_TIMEOUT=60
STUDENT_DIFY_LEAVE_VERSION=student-leave-v1
STUDENT_SCORE_DIFY_BASE=http://127.0.0.1/v1
STUDENT_SCORE_DIFY_KEY=
