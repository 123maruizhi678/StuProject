# ===== 日志配置 =====
# 日志等级：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志目录，留空则默认输出到 <项目根>/app/logs
LOG_DIR=

# ===== 数据库配置（后续 database.py 启用）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345
DB_NAME=education_agent
DB_ECHO=false

# ===== Dify NL2SQL 工作流配置 =====
DIFY_API_BASE=http://127.0.0.1/v1
DIFY_API_KEY=app-W2OQ0L4BnDPw34EsQ5Uc9ntq
# Dify 工作流输出中存放 SQL 的变量名（如与实际不符请修改）
DIFY_SQL_OUTPUT_KEY=sql
