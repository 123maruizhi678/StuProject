# 本机运行配置：包含真实凭据，不要公开提交或共享。
# 配置由 .env 读取，同名系统环境变量优先。

# ===== 1. MySQL：本机连接配置 =====
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="123456"
DB_NAME="stuproject"
DB_ECHO="false"
# 密码保留原始字符；本文件包含真实凭据，请勿公开提交。
# 本文件不创建数据库或数据表；认证成功后再运行只读结构预检。

# ===== 2. 统一登录：独立随机签名密钥 =====
# AUTH_SECRET_KEY 与 STUDENT_ACTION_SECRET 使用不同随机值，至少32字节。
AUTH_SECRET_KEY="UyqoDTbvljW_rMS36izj2BHw1-GtHgYwc0JQbYbCyMOHP4hvhD2tC2Mr5VEvcao5"
AUTH_TOKEN_EXPIRE_MINUTES="120"

# ===== 3. Dify 公共连接与唯一学生应用 =====
# API 基址包含 /v1，末尾不要填写 /workflows/run。
DIFY_API_BASE="http://192.168.5.12/v1"
DIFY_API_TIMEOUT_SECONDS="60"
# 填写已发布的学生统一 Workflow 应用 API Key。
STUDENT_DIFY_KEY="app-hqupmnVBKK1raYEj1uKcbLD5"
# 仅签发学生会话和办理确认凭证，不替代公共登录 JWT。
STUDENT_ACTION_SECRET="R9kzM0VKlJmaVcO8VFxLynkPTbQDR1X0oHPQnaUvqj025xiFzZg6J7FHsxa7xkzF"
STUDENT_ACTION_TTL_SECONDS="300"
STUDENT_TOKEN_ISSUER="stuproject"
STUDENT_ANALYSIS_VERSION="student-assistant-v1"

# ===== 4. 本地固定查询、知识与课程 =====
# local 读取本地固定查询，不需要额外部署学生 NL2SQL 智能体。
STUDENT_QUERY_BACKEND="local"
STUDENT_KNOWLEDGE_FILE="dify/student/knowledge.json"
STUDENT_COURSES_FILE="scripts/student/student_courses.json"
# 真实课程及选课关系由维护人员配置，格式参照 scripts/student/student_courses.example.json。
# 文件不存在时课程接口返回依赖未就绪，不从成绩或招生项目猜测课程。

# ===== 5. 站内通知与负责人接管 =====
STUDENT_NOTIFICATION_MAX_ATTEMPTS="5"
STUDENT_NOTIFICATION_LEASE_SECONDS="60"
# 额外分派授权：员工内部ID对应允许接管的部门内部ID列表。
STUDENT_LEAVE_ASSIGNMENT_SCOPES="{}"
# 心理分派需同时配置专属授权人员及学生范围。
STUDENT_WARNING_ASSIGNER_IDS="[]"
STUDENT_WARNING_ASSIGNMENT_SCOPES="{}"

# ===== 6. 可选外部适配：当前本地流程无需开启 =====
# 数组/对象字段必须使用合法JSON；留空表示不配置相应外部适配。
STUDENT_SYNC_ENABLED="false"
STUDENT_SYNC_TOKEN=
STUDENT_SYNC_ALLOWED_SOURCES="[]"
STUDENT_SYNC_ALLOWED_STUDENT_IDS="[]"
STUDENT_SYNC_INTERVAL_SECONDS="300"
STUDENT_EDUCATION_URL=
STUDENT_EDUCATION_TOKEN=
STUDENT_CRM_URL=
STUDENT_CRM_TOKEN=
# 仅切换到已实现 student-v1 契约的 group 查询服务时填写。
STUDENT_NL2SQL_URL=
STUDENT_NL2SQL_TOKEN=
STUDENT_HTTP_TIMEOUT="30"
# 当前通知任务只启用站内发布，不需要Webhook。
STUDENT_NOTIFICATION_URL=
STUDENT_NOTIFICATION_TOKEN=

# ===== 7. 公共日志 =====
LOG_LEVEL="INFO"
# 留空时使用项目 app/logs 目录。
LOG_DIR=

