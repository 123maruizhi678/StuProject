# 追加学生模块配置到现有.env；不要覆盖已有数据库和组长NL2SQL配置。
# 至少32字节的随机密钥；生产接入统一登录方，勿把密钥发给学生或写进Git。
STUDENT_AUTH_SECRET=
STUDENT_TOKEN_ISSUER=stuproject
STUDENT_ACTION_TTL_SECONDS=300
# 三个学生应用的独立Key，不能填组长NL2SQL应用Key。
STUDENT_DIFY_CHAT_KEY=
STUDENT_DIFY_MENTAL_KEY=
STUDENT_DIFY_TICKET_KEY=
STUDENT_ANALYSIS_VERSION=student-v1
STUDENT_HTTP_TIMEOUT=30
# 默认group接组长受控查询；本机联调可显式设local，固定SQL读真实本地表。
STUDENT_QUERY_BACKEND=group
# 组长提供符合student-v1契约的受控查询入口。
STUDENT_NL2SQL_URL=
STUDENT_NL2SQL_TOKEN=
STUDENT_EDUCATION_URL=
STUDENT_EDUCATION_TOKEN=
STUDENT_CRM_URL=
STUDENT_CRM_TOKEN=
STUDENT_FALLBACK_EMPLOYEE_ID=
STUDENT_NOTIFICATION_MAX_ATTEMPTS=5
STUDENT_NOTIFICATION_LEASE_SECONDS=120
STUDENT_SYNC_INTERVAL_SECONDS=300
# 24/72小时为首期可配置默认值，真实SLA需与企业模块约定。
STUDENT_TICKET_RESPONSE_HOURS=24
STUDENT_TICKET_RESOLUTION_HOURS=72
