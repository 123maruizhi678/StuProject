# PLACEHOLDER ONLY: template contains no real secrets.
# Local enterprise applications are deployed; their real settings belong in
# Git-ignored .env.enterprise.local. Do not overwrite the existing .env.

# Current declared fields
LOG_LEVEL=INFO
LOG_DIR=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=__PLACEHOLDER_DB_USER__
DB_PASSWORD=
DB_NAME=education_agent
DB_ECHO=false
AUTH_SECRET_KEY=
# Generate a unique local random value (at least 32 bytes) before JWT login.
AUTH_TOKEN_EXPIRE_MINUTES=120
DIFY_API_BASE=http://127.0.0.1/v1
DIFY_API_TIMEOUT_SECONDS=60
DIFY_API_KEY=app-PLACEHOLDER_LEGACY_NL2SQL_NOT_PUBLISHED
DIFY_SQL_OUTPUT_KEY=sql
REPORT_DIFY_API_BASE=
REPORT_DIFY_API_KEY=app-PLACEHOLDER_REPORT_NOT_PUBLISHED
REPORT_DIFY_OUTPUT_KEY=report_text
# Existing local test setting; external score authority requires its own contract.
ENTERPRISE_SCORE_AUTHORITY=local
ENTERPRISE_STUDENT_MAINTAINER_IDS=[]
# Legacy declarations only; do not deploy extra student apps for the target design.
STUDENT_SCORE_DIFY_BASE=http://127.0.0.1/v1
STUDENT_SCORE_DIFY_KEY=app-PLACEHOLDER_LEGACY_SCORE_NOT_PUBLISHED
STUDENT_DIFY_LEAVE_KEY=app-PLACEHOLDER_LEGACY_LEAVE_NOT_PUBLISHED
STUDENT_DIFY_LEAVE_TIMEOUT=60
STUDENT_DIFY_LEAVE_VERSION=student-leave-v1

# PLANNED: Settings/clients must be implemented before these become effective.
DIFY_CLIENT=mock
DIFY_AGENT_API_KEY=app-PLACEHOLDER_AGENT_NOT_PUBLISHED
DIFY_NL2SQL_API_KEY=app-PLACEHOLDER_LEGACY_NL2SQL_NOT_PUBLISHED
DIFY_NL2SQL_OUTPUT_KEY=sql
STUDENT_DIFY_KEY=app-PLACEHOLDER_STUDENT_UNIFIED_NOT_PUBLISHED
STUDENT_QUERY_BACKEND=local
STUDENT_ACTION_SECRET=
STUDENT_KNOWLEDGE_FILE=
# Implemented enterprise fields; configure actual values in .env.enterprise.local.
ENTERPRISE_EXTRACT_DIFY_API_KEY=app-PLACEHOLDER_ENTERPRISE_EXTRACT_NOT_PUBLISHED
ENTERPRISE_NL2SQL_DIFY_API_KEY=app-PLACEHOLDER_ENTERPRISE_NL2SQL_NOT_PUBLISHED
# One application with QA/RAG branches, not separate keys.
ENTERPRISE_KNOWLEDGE_DIFY_API_KEY=app-PLACEHOLDER_ENTERPRISE_KNOWLEDGE_NOT_PUBLISHED
ENTERPRISE_SUMMARY_DIFY_API_KEY=app-PLACEHOLDER_ENTERPRISE_SUMMARY_NOT_PUBLISHED
ENTERPRISE_DIFY_CONTRACT_VERSION=enterprise-v1
ENTERPRISE_CONFIRM_SECRET=
ENTERPRISE_PHONE_ENCRYPTION_KEY=
ENTERPRISE_PHONE_LOOKUP_SECRET=
ENTERPRISE_READ_DB_USER=__PLACEHOLDER_READONLY_USER__
ENTERPRISE_READ_DB_PASSWORD=
# Schedule settings belong to report_config, not invented runtime env flags.
# See business document configuration examples: Asia/Shanghai, daily 17:00,
# weekly Friday 17:00. No scheduler is started by this template.

# Enterprise runtime overrides: .env.enterprise.local (Git ignored).
# Fields below are implemented in app/config.py.
# Education and CRM pages use the project's authenticated backend and local DB.
# No external education/CRM endpoint or notification webhook is required.
ASR_BACKEND=faster_whisper
ASR_MODEL_SIZE=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MODEL_PATH=__PLACEHOLDER_LOCAL_MODEL_DIRECTORY__
ENTERPRISE_QUERY_TIMEOUT_MS=3000
ENTERPRISE_TASK_INTERVAL_SECONDS=300
# Students/employees receive in-app personal notifications; no cloud push key.
# Future external sync only; not required for local pages:
STUDENT_SYNC_TOKEN=
